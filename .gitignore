# Local environments and caches
.venv/
# Shared, reusable Megatron-SWIFT LoRA runtime (compiled Python 3.12 + venv +
# pip cache + build deps).  Lives on the shared mount so any worker can reuse it.
/.omni_lora_runtime/
.env
.env.*
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/
.DS_Store

# Project-local generated artifacts
/.coco/
/.pip-cache/
/.tmp/

# Large local datasets and model weights
/eval_data/
/models/

# Local runtime installations and private machine configuration
/.runtime/
/.local-tools/
/.agents/
/.codex/
/.aws/

# Model checkpoints; calibration pool_*.pt files are experiment records
*.safetensors
*.gguf
*.ggml
*.ckpt
**/pytorch_model*.bin
**/adapter_model.bin
**/consolidated*.pth

# Dataset bodies remain on shared storage; see docs/DATA_STORAGE.md
/ft_data/
